<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <Color x:Key="AppBackgroundColor">#F4F7FB</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="HeaderBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ElevatedBackgroundColor">#F8FAFC</Color>
    <Color x:Key="HoverBackgroundColor">#EEF2F7</Color>
    <Color x:Key="SelectedRowBackgroundColor">#E3EEFF</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>

    <!-- Brand & Semantics -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentSubtleColor">#DBEAFE</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningSubtleColor">#FEF3C7</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSubtleColor">#FEE2E2</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="SuccessSubtleColor">#D1FAE5</Color>

    <!-- Market quote colors -->
    <Color x:Key="MarketRedColor">#DC2626</Color>
    <Color x:Key="MarketGreenColor">#059669</Color>
    <Color x:Key="MarketFlatColor">#64748B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="{StaticResource ElevatedBackgroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedRowBackgroundBrush" Color="{StaticResource SelectedRowBackgroundColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />

    <SolidColorBrush x:Key="MarketRedBrush" Color="{StaticResource MarketRedColor}" />
    <SolidColorBrush x:Key="MarketGreenBrush" Color="{StaticResource MarketGreenColor}" />
    <SolidColorBrush x:Key="MarketFlatBrush" Color="{StaticResource MarketFlatColor}" />
</ResourceDictionary>
