<Window x:Class="MarketWatch.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索并添加自选标的"
        Icon="pack://application:,,,/Assets/vegetable.png"
        Width="560"
        Height="500"
        MinWidth="460"
        MinHeight="400"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFont}"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Input -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     KeyDown="OnSearchBoxKeyDown"
                     Margin="0,0,8,0" />
            <Button Grid.Column="1"
                    Content="搜索"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="18,6" />
        </Grid>

        <!-- Quick Market Preset Filter Pills -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
            <TextBlock Text="常用预设：" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="全部" Command="{Binding FilterPresetsCommand}" CommandParameter=""
                    Style="{StaticResource SubtleButtonStyle}" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="港股" Command="{Binding FilterPresetsCommand}" CommandParameter="HK"
                    Style="{StaticResource SubtleButtonStyle}" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="沪深" Command="{Binding FilterPresetsCommand}" CommandParameter="CN"
                    Style="{StaticResource SubtleButtonStyle}" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="美股" Command="{Binding FilterPresetsCommand}" CommandParameter="US"
                    Style="{StaticResource SubtleButtonStyle}" Padding="10,3" />
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   FontSize="11.5"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,8" />

        <!-- Result List -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <ListBox ItemsSource="{Binding Results}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                                            CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding MarketLabel}" FontSize="10.5"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                                            CornerRadius="4" Padding="6,1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0">
                                    <Run Text="{Binding DisplayCode, Mode=OneWay}" />
                                    <Run Text="  ·  来源：" />
                                    <Run Text="{Binding Source, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.AddInstrumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    VerticalAlignment="Center"
                                    Padding="12,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Content" Value="+ 添加" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                                                <Setter Property="Content" Value="已添加" />
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    Content="完成"
                    Click="OnCloseClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="20,6" />
            <CheckBox Content="添加时同步显示到悬浮小窗"
                      IsChecked="{Binding AddToMiniWindow}"
                      FontSize="12"
                      VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
