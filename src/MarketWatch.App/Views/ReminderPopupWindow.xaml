<Window x:Class="MarketWatch.App.Views.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Assets/vegetable.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        KeyDown="OnWindowKeyDown"
        Loaded="OnWindowLoaded"
        Closed="OnWindowClosed">

    <Grid Margin="14">
        <!-- Soft drop shadow container -->
        <Border x:Name="OuterFrame"
                MinWidth="450"
                MaxWidth="560"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2.5"
                CornerRadius="14"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <Grid>
                <!-- Subtle breathing glow border overlay for Strong Reminder (slow ~1.6s ease, no rapid strobe) -->
                <Border x:Name="BreathingBorder"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="3"
                        Opacity="0"
                        IsHitTestVisible="False" />

                <StackPanel Margin="22,18,22,20">
                    <!-- Draggable Header -->
                    <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border x:Name="BadgeBorder"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    CornerRadius="5"
                                    Padding="8,3"
                                    Margin="0,0,0,8">
                                <TextBlock x:Name="BadgeTextBlock"
                                           Text="{Binding BadgeText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>

                            <TextBlock x:Name="TitleTextBlock"
                                       Text="{Binding Title}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding DismissCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Top"
                                Padding="8,4"
                                ToolTip="关闭 (Esc)" />
                    </Grid>

                    <!-- Live Quote Card -->
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,14,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding InstrumentTitle}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,6" VerticalAlignment="Bottom">
                                <TextBlock x:Name="PriceTextBlock"
                                           Text="{Binding PriceText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{Binding ChangeBrush}"
                                           VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding ChangeText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding ChangeBrush}"
                                           Margin="12,0,0,4"
                                           VerticalAlignment="Bottom"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Text="{Binding QuoteMetaText}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Countdown / Cutoff Status Banner -->
                    <Border x:Name="CountdownBanner"
                            Background="{DynamicResource WarningSubtleBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="CountdownTextBlock"
                                       Text="{Binding CountdownText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BeijingTimeText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Optional calendar / catch-up notice -->
                    <Border Background="{DynamicResource AccentSubtleBrush}"
                            CornerRadius="6"
                            Padding="10,7"
                            Margin="0,0,0,10"
                            Visibility="{Binding ExtraNoticeText, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="{Binding ExtraNoticeText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Non-misleading Disclaimer -->
                    <TextBlock Text="{Binding DisclaimerText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="按 Esc 或 Enter 可关闭"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="稍后提醒（1分钟）"
                                Command="{Binding SnoozeOneMinuteCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{Binding CanSnooze, Converter={StaticResource BoolToVisibility}}"
                                Padding="14,8"
                                Margin="0,0,10,0" />

                        <Button Grid.Column="2"
                                Content="知道了"
                                Command="{Binding DismissCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="22,8"
                                FontSize="13.5" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
