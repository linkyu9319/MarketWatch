<Window x:Class="MarketWatch.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="青菜盯盘 · 软件更新"
        Icon="pack://application:,,,/Assets/vegetable.png"
        Width="520"
        SizeToContent="Height"
        MinHeight="340"
        MaxHeight="620"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFont}"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">

    <StackPanel Margin="20,18,20,18">
        <!-- Title Header -->
        <DockPanel Margin="0,0,0,12">
            <Border DockPanel.Dock="Right"
                    Background="{DynamicResource AccentSubtleBrush}"
                    CornerRadius="6"
                    Padding="8,3"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentVersionText}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel>
                <TextBlock Text="软件更新" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="从 GitHub Releases 检查并校验青菜盯盘（MarketWatch）的最新正式版本"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Status Card -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding StatusHeadline}"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding VersionMetaText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding VersionMetaText, Converter={StaticResource StringToVisibility}}" />

                <!-- Release Notes Preview -->
                <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,10,0,0"
                        MaxHeight="130"
                        Visibility="{Binding ReleaseNotesText, Converter={StaticResource StringToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotesText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <!-- Download Progress -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgressPercent}" Height="8" />
                    <TextBlock Text="{Binding ProgressText}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>

                <!-- Ready message -->
                <TextBlock Text="{Binding ProgressText}"
                           FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsReadyToRestart, Converter={StaticResource BoolToVisibility}}" />

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="立即重启更新"
                    Command="{Binding ApplyAndRestartCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding IsReadyToRestart, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,8,6" />

            <Button Content="一键更新"
                    Command="{Binding InstallUpdateCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,8,6" />

            <Button Content="取消下载"
                    Command="{Binding CancelDownloadCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,8,6" />

            <Button Content="检查更新"
                    Command="{Binding CheckForUpdatesCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    Margin="0,0,8,6" />

            <Button Content="查看发布页"
                    Command="{Binding OpenReleasesPageCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    Margin="0,0,8,6" />
        </WrapPanel>

        <!-- Optional GitHub Token Card (mirrors VSRead) -->
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="GitHub 只读访问令牌（可选）" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TokenStatusText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="TokenBox"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="保存令牌" Click="OnSaveTokenClick"
                            Style="{StaticResource SubtleButtonStyle}" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="清除" Command="{Binding ClearTokenCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            IsEnabled="{Binding HasSavedToken}" />
                </Grid>
            </StackPanel>
        </Border>

        <Button Content="关闭"
                Command="{Binding CloseCommand}"
                Style="{StaticResource SubtleButtonStyle}"
                HorizontalAlignment="Right"
                Padding="20,6" />
    </StackPanel>
</Window>
