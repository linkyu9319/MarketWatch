<Window x:Class="MarketWatch.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarketWatch 设置"
        Width="740"
        Height="580"
        MinWidth="660"
        MinHeight="500"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFont}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Tab 1: General & Appearance -->
            <TabItem Header="常规与外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel Margin="4">
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="界面与行情设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="界面主题" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="240" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Text="涨跌配色方案" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ColorSchemes}" SelectedItem="{Binding ColorScheme}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="260" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Text="默认主数据源" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding PrimaryProvider}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="240" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="3" Text="行情刷新间隔（秒）" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Value="{Binding RefreshIntervalSeconds}" Width="200" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RefreshIntervalSeconds, StringFormat='{}{0} 秒'}"
                                                   FontFamily="{StaticResource MonoFont}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Text="迷你悬浮窗透明度" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Minimum="0.55" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                                Value="{Binding MiniWindowOpacity}" Width="200" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MiniWindowOpacity, StringFormat='{}{0:P0}'}"
                                                   FontFamily="{StaticResource MonoFont}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="托盘、提醒体验与启动行为" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <CheckBox Content="最小化窗口时隐藏到系统托盘" IsChecked="{Binding MinimizeToTray}" Margin="0,4" />
                                <CheckBox Content="点击主窗口关闭按钮时进入托盘（仅从托盘菜单退出才停止监控）" IsChecked="{Binding CloseToTray}" Margin="0,4" />
                                <CheckBox Content="托盘图标悬停提示中显示首条自选行情（默认关闭，仅显示软件名称）" IsChecked="{Binding ShowQuoteInTrayTooltip}" Margin="0,4" />
                                <CheckBox Content="强提醒启用缓慢呼吸边框动画（约 1.6 秒周期，无频闪）" IsChecked="{Binding EnableAnimations}" Margin="0,4" />
                                <CheckBox Content="强提醒启用全屏半透明遮罩（默认关闭，仅在需要极强视觉提示时开启）" IsChecked="{Binding EnableFullScreenOverlayForStrong}" Margin="0,4" />
                                <CheckBox Content="提醒弹窗时播放系统提示音（默认关闭，保持静音友好）" IsChecked="{Binding EnableReminderSound}" Margin="0,4" />
                                <CheckBox Content="开机自动启动并最小化到托盘（默认关闭，写入当前用户 HKCU 启动项）" IsChecked="{Binding AutoStartEnabled}" Margin="0,8,0,4" />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="静音测试普通提醒" Command="{Binding TestNormalReminderCommand}"
                                            Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" />
                                    <Button Content="静音测试强提醒（14:55 样式）" Command="{Binding TestStrongReminderCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Scheduled Reminder Rules -->
            <TabItem Header="定时提醒">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="全部基金交易截止提醒固定采用北京时间（UTC+8），不依赖系统时区。"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="+ 新增提醒规则"
                                Command="{Binding AddReminderRuleCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReminderRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" Content="启用" Margin="0,0,10,0" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="240" Margin="0,0,10,0" />
                                                    <TextBlock Text="触发(HH:mm):" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBox Text="{Binding TriggerTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="66" Margin="0,0,10,0" />
                                                    <TextBlock Text="截止:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBox Text="{Binding CutoffTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="66" Margin="0,0,10,0" />
                                                    <Button Content="删除"
                                                            Command="{Binding DataContext.RemoveReminderRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SubtleButtonStyle}" Padding="8,4" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                    <TextBlock Text="重复模式:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <ComboBox ItemsSource="{Binding DataContext.RepeatModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding RepeatMode}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="210" Margin="0,0,14,0" />
                                                    <TextBlock Text="提醒强度:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <ComboBox ItemsSource="{Binding DataContext.Strengths, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Strength}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="145" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Price / Change% Alerts (P1) -->
            <TabItem Header="价格预警">
                <Grid Margin="4,10,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="新增价格或涨跌幅阈值预警（数据过期时自动拒绝触发，且具备冷却与反向复位机制）"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding AvailableInstruments}" SelectedItem="{Binding NewAlertInstrument}"
                                          DisplayMemberPath="Name" Width="140" Margin="0,0,8,6" />
                                <ComboBox ItemsSource="{Binding AlertMetrics}" SelectedItem="{Binding NewAlertMetric}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="115" Margin="0,0,8,6" />
                                <ComboBox ItemsSource="{Binding AlertDirections}" SelectedItem="{Binding NewAlertDirection}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="105" Margin="0,0,8,6" />
                                <TextBox Text="{Binding NewAlertThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" Width="80" Margin="0,0,8,6" ToolTip="阈值" />
                                <TextBlock Text="冷却(分):" VerticalAlignment="Center" Margin="0,0,4,6" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding NewAlertCooldown, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" Width="50" Margin="0,0,10,6" />
                                <Button Content="+ 添加预警" Command="{Binding AddPriceAlertCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding PriceAlerts}" Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="启用" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="标的" Binding="{Binding InstrumentName}" Width="*" />
                                <DataGridTextColumn Header="指标" Binding="{Binding MetricDisplay}" Width="90" />
                                <DataGridTextColumn Header="条件" Binding="{Binding DirectionDisplay}" Width="80" />
                                <DataGridTextColumn Header="阈值" Binding="{Binding Threshold}" Width="90" />
                                <DataGridTextColumn Header="冷却(分)" Binding="{Binding CooldownMinutes}" Width="80" />
                                <DataGridTemplateColumn Header="操作" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删除"
                                                    Command="{Binding DataContext.RemovePriceAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SubtleButtonStyle}" Padding="8,3" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 4: Trading Calendar (P1) -->
            <TabItem Header="交易日历">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="交易日历覆盖与状态" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding TodayCalendarStatusText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CalendarCoverageText}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="默认日历模式：" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding DefaultCalendarMode}" ItemTemplate="{StaticResource EnumComboItemTemplate}" Width="240" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Custom Holidays -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="自定义休市日（如港股/QDII 暂停申赎日）" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="添加" Command="{Binding AddCustomHolidayCommand}" Style="{StaticResource SubtleButtonStyle}" Margin="6,0,0,0" />
                                        <TextBox Text="{Binding NewHolidayDateText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" ToolTip="yyyy-MM-dd" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding CustomHolidayDates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <Button DockPanel.Dock="Right" Content="移除"
                                                            Command="{Binding DataContext.RemoveCustomHolidayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SubtleButtonStyle}" Padding="6,2" />
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Custom Open Days -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="自定义开放日（强制提醒日期）" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="添加" Command="{Binding AddCustomOpenDayCommand}" Style="{StaticResource SubtleButtonStyle}" Margin="6,0,0,0" />
                                        <TextBox Text="{Binding NewOpenDateText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" ToolTip="yyyy-MM-dd" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding CustomOpenDates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <Button DockPanel.Dock="Right" Content="移除"
                                                            Command="{Binding DataContext.RemoveCustomOpenDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SubtleButtonStyle}" Padding="6,2" />
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: Data & Config Import/Export (P2) -->
            <TabItem Header="数据与配置">
                <StackPanel Margin="4,10,4,4">
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="本地配置管理（无云端账号，不上传任何遥测数据）" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding ConfigPathText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="导出配置 (JSON)" Command="{Binding ExportConfigCommand}" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="导入配置 (JSON)" Command="{Binding ImportConfigCommand}" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="检查软件更新..." Command="{Binding OpenUpdatesCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="行情数据源健康状态" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="刷新状态" Command="{Binding RefreshProviderHealthCommand}"
                                        Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Right" Padding="10,4" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding ProviderHealthList}" Style="{StaticResource ModernDataGridStyle}" Height="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="数据源" Binding="{Binding ProviderName}" Width="110" />
                                    <DataGridTextColumn Header="健康" Binding="{Binding IsHealthy}" Width="70" />
                                    <DataGridTextColumn Header="连续失败" Binding="{Binding ConsecutiveFailures}" Width="80" />
                                    <DataGridTextColumn Header="最近成功" Binding="{Binding LastSuccessAt, StringFormat='HH:mm:ss'}" Width="100" />
                                    <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}"
                    Style="{StaticResource SubtleButtonStyle}" Padding="18,6" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="保存并生效" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,6" />
        </Grid>
    </Grid>
</Window>
